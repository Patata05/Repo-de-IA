# Backend Django del chatbot (Backend-ia)
# Vacío o :8000 → el front usa /api/chat (proxy a Backend-ia)
NEXT_PUBLIC_CHAT_API_URL=
CHAT_BACKEND_URL=http://127.0.0.1:8000

# n8n se configura en Backend-ia/.env (N8N_INVENTARIO_URL / N8N_INVENTARIO_KEY).
# Híbrido recomendado: local = detectores + panel; n8n solo consultas abiertas
NEXT_PUBLIC_CHAT_CONSULTAS=local
# Consultas abiertas sin detector: n8n | deepseek
NEXT_PUBLIC_CHAT_FALLBACK=n8n

# Workflow n8n: mapear systemFacts + threadFocus al system prompt del Agent.
# Acciones opcionales en reply: [[ACCION:{"tipo":"mostrar_panel","persona":"...","overview":"personTotal"}]]
# o array acciones: refrescar | exportar_excel | mostrar_panel

# Supabase (ver también Database/.env.example)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
