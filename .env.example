# Backend Django del chatbot (Backend-ia)
# Vacío o :8000 → el front usa /api/chat (proxy a Backend-ia)
NEXT_PUBLIC_CHAT_API_URL=
CHAT_BACKEND_URL=http://127.0.0.1:8000

# Consultas de lectura: agent (pydantic-ai+tools, recomendado) | local | n8n
NEXT_PUBLIC_CHAT_CONSULTAS=agent
# Fallback si no hay detector local (solo modo local): deepseek | n8n
NEXT_PUBLIC_CHAT_FALLBACK=deepseek

# n8n (opt-in): Backend-ia/.env → N8N_INVENTARIO_URL / N8N_INVENTARIO_KEY
# Acciones opcionales: [[ACCION:{"tipo":"mostrar_panel",...}]]

# Supabase (ver también Database/.env.example)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
