# Copia este archivo a .env y llena solo en tu máquina local.
# Nunca subas .env a GitHub.

# --- Supabase (inventario; sin datos en el repo) ---
# Usa la URL del proyecto y la anon/publishable key (no la service_role en front).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
# Opcional (solo backend; no la compartas):
# SUPABASE_SERVICE_ROLE_KEY=

# --- LLM (al menos una API key o Ollama local) ---
LLM_PROVIDERS=groq,deepseek,ollama,gemini

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# DeepSeek: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Ollama local: https://ollama.com/download
# ollama pull llama3.2
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
