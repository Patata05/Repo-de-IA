# Copia a .env en tu máquina. Nunca subas .env a GitHub.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=

# --- Solo DeepSeek ---
LLM_PROVIDERS=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# --- n8n (opt-in; vacío = no se usa, el chat sigue con DeepSeek) ---
# Webhook Agent: usar systemFacts + threadFocus / lastUser / threadSummary.
# Respuesta: { "reply": "..." } y opcional acciones / [[ACCION:{...}]].
# Tipos: refrescar | exportar_excel | mostrar_panel
#   mostrar_panel: { "tipo":"mostrar_panel", "overview":"personTotal|recent|...", "persona"|"area"|"origen"|"focus", "limit"? }
N8N_INVENTARIO_URL=
N8N_INVENTARIO_KEY=
