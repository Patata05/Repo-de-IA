# Copia a .env en tu máquina. Nunca subas .env a GitHub.

# --- Supabase (inventario; sin datos en el repo) ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# --- LLM: Muse (Meta) primero, luego DeepSeek / Groq como respaldo ---
# Key: https://dev.meta.ai → API keys (formato LLM_...)
LLM_PROVIDERS=muse,deepseek,groq,ollama,gemini

MODEL_API_KEY=
# Alias opcionales de la misma key:
# META_API_KEY=
# MUSE_API_KEY=
MUSE_MODEL=muse-spark-1.3
# Alternativa más capaz (si tu cuenta la tiene):
# MUSE_MODEL=muse-wonder-1.0
META_BASE_URL=https://api.meta.ai/v1

# DeepSeek (respaldo, igual que antes)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Ollama local
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
